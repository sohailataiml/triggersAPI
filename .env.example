# ---------------------------------------------------------------------------
# TriggersAPI environment configuration.
# Copy to .env and adjust. All variables are validated at startup (fail-fast).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres — NOTE: host port 5433 avoids a clash with other local stacks on 5432.
DATABASE_URL=postgresql://triggers:triggers@localhost:5433/triggers?schema=public

# Redis — host port 6380 avoids a clash with other local stacks on 6379.
REDIS_URL=redis://localhost:6380

# Secrets — replace in any non-local environment.
API_KEY_PEPPER=dev-pepper-change-me
LEASE_TOKEN_SECRET=dev-lease-secret-change-me

# Limits & defaults
MAX_EVENT_BYTES=262144
MAX_LONG_POLL_SECONDS=30
DEFAULT_VISIBILITY_TIMEOUT_SECONDS=60
DEFAULT_MAX_ATTEMPTS=5
MAX_ACTIVE_LONG_POLLS_PER_KEY=50
EXPLORER_STREAM_MAX_LENGTH=1000

# CORS (comma-separated origins). Explorer dev server default:
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# MCP server (apps/mcp) — exposes the API to AI agents over the Model Context
# Protocol. It talks to the API over HTTP only; no DB or Redis access.
# ---------------------------------------------------------------------------

TRIGGERS_API_URL=http://localhost:3000

# Role keys from `pnpm db:seed`. Only tools for the roles you set are exposed,
# so a producer-only setup never advertises admin tools. At least one required.
TRIGGERS_ADMIN_TOKEN=
TRIGGERS_PRODUCER_TOKEN=
TRIGGERS_CONSUMER_TOKEN=

# Must exceed MAX_LONG_POLL_SECONDS (validated: minimum 35000).
TRIGGERS_REQUEST_TIMEOUT_MS=45000

# Exposes the destructive reset_workspace tool. Leave false outside demos.
TRIGGERS_MCP_ENABLE_RESET=false

# --- Streamable HTTP transport only (not used by the stdio entrypoint) ---
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3100

# header — each caller supplies their own keys via X-Triggers-*-Token headers
#          and this process stores none (default; safe to expose).
# shared  — callers present MCP_HTTP_AUTH_TOKEN as a bearer and the server
#          lends them its own keys above. Single-operator deployments only.
MCP_HTTP_AUTH_MODE=header
MCP_HTTP_AUTH_TOKEN=

# DNS-rebinding protection; enforced only when non-empty (comma-separated).
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Zapier AI Automation Copilot (apps/copilot) — the agent runtime.
#
# Every value below is read by the Copilot SERVER only. The browser talks solely
# to that server, so neither the model key nor the Triggers tokens are ever sent
# to the page or stored in browser storage.
# ---------------------------------------------------------------------------

# Model credential — the ONLY value you need to supply by hand. Everything below
# is written for you by `pnpm demo:setup`. Absent is a supported state: the
# Copilot renders a setup screen rather than a chat box that fails on first use.
ANTHROPIC_API_KEY=

COPILOT_MODEL=claude-opus-5
# low | medium | high | xhigh | max — trades latency and tokens against depth.
COPILOT_EFFORT=medium
COPILOT_MAX_TOKENS=16000
# Ceiling on tool round-trips per user message; stops runaway agent loops.
COPILOT_MAX_ITERATIONS=12

COPILOT_HOST=0.0.0.0
COPILOT_PORT=3200

# The Triggers MCP server. Every state-changing operation goes through here.
MCP_SERVER_URL=http://127.0.0.1:3100/mcp

# Read-only: used solely to proxy the live activity SSE stream for the context
# panel, which MCP has no equivalent for.
TRIGGERS_API_URL=http://127.0.0.1:3000

# Where "Open in Explorer" links point.
EXPLORER_URL=http://localhost:5173

# The Copilot forwards TRIGGERS_{ADMIN,PRODUCER,CONSUMER}_TOKEN above to the MCP
# server as X-Triggers-*-Token headers. Any subset works — the UI only offers
# the capabilities those tokens actually grant.
#
# `pnpm demo:setup` writes those three tokens, TRIGGERS_API_URL, MCP_SERVER_URL,
# and the VITE_DEMO_* values the Explorer uses to auto-connect. It is idempotent:
# re-running reuses whatever still authenticates and mints only the rest.
