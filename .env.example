# ---------------------------------------------------------------------------
# TriggersAPI environment configuration.
# Copy to .env and adjust. All variables are validated at startup (fail-fast).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres — NOTE: host port 5433 avoids a clash with other local stacks on 5432.
DATABASE_URL=postgresql://triggers:triggers@localhost:5433/triggers?schema=public

# Redis — host port 6380 avoids a clash with other local stacks on 6379.
REDIS_URL=redis://localhost:6380

# Secrets — replace in any non-local environment.
API_KEY_PEPPER=dev-pepper-change-me
LEASE_TOKEN_SECRET=dev-lease-secret-change-me

# Limits & defaults
MAX_EVENT_BYTES=262144
MAX_LONG_POLL_SECONDS=30
DEFAULT_VISIBILITY_TIMEOUT_SECONDS=60
DEFAULT_MAX_ATTEMPTS=5
MAX_ACTIVE_LONG_POLLS_PER_KEY=50
EXPLORER_STREAM_MAX_LENGTH=1000

# CORS (comma-separated origins). Explorer dev server default:
CORS_ORIGINS=http://localhost:5173
